---
interface Props {
  title: string;
  meta: string;
  category?: string;
  intro: string;
  github: string;
  links?: {
    label: string;
    url: string;
  }[];
  featured?: boolean;
}

const { title, meta, category, intro, github, links, featured = false } =
  Astro.props;
const primaryLink = links?.[0] ?? { label: "View repository", url: github };
const extraLinks = links && links.length > 1 ? links.slice(1) : [];
---

<article class="group flex h-full flex-col">
  <a
    href={primaryLink.url}
    target="_blank"
    class:list={[
      "tile-card relative flex h-full flex-col overflow-hidden rounded-[1.75rem]",
      featured
        ? "gap-6 p-7 sm:p-9"
        : "gap-4 p-6 sm:gap-5 sm:p-7",
    ]}
  >
    <div
      class:list={[
        "pointer-events-none absolute inset-x-0 top-0 bg-gradient-to-r from-transparent via-gruv-blue/30 to-transparent opacity-0 transition-opacity group-hover:opacity-100",
        featured ? "h-0.5" : "h-px",
      ]}
    ></div>

    {
      featured && (
        <div
          class="pointer-events-none absolute -top-24 -right-16 h-48 w-48 rounded-full opacity-40 blur-3xl"
          style="background: var(--theme-glow-blue)"
          aria-hidden="true"
        />
      )
    }

    <div class="flex items-start justify-between gap-4">
      <div class="flex flex-col gap-2">
        {
          category && (
            <span class="w-fit rounded-full bg-gruv-blue/10 px-3 py-1 text-[11px] font-medium text-gruv-blue">
              {category}
            </span>
          )
        }
        <span class="text-xs text-gruv-muted">{meta}</span>
      </div>
      <svg
        class:list={[
          "shrink-0 text-gruv-muted opacity-0 transition-all group-hover:translate-x-0.5 group-hover:opacity-100",
          featured ? "mt-1" : "",
        ]}
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </div>

    <div class="relative flex flex-1 flex-col gap-3">
      <h4
        class:list={[
          "font-semibold tracking-tight",
          featured ? "text-2xl sm:text-[1.75rem]" : "text-lg sm:text-xl",
        ]}
      >
        {title}
      </h4>
      <p
        class:list={[
          "leading-relaxed text-gruv-muted",
          featured
            ? "line-clamp-4 text-base"
            : "line-clamp-2 text-sm sm:line-clamp-3",
        ]}
      >
        {intro}
      </p>
    </div>

    {
      extraLinks.length > 0 && (
        <div class="mt-auto flex flex-wrap gap-2 border-t border-gruv-border/15 pt-4">
          {extraLinks.map((link) => (
            <span class="rounded-full border border-gruv-border/20 px-2.5 py-0.5 text-[11px] text-gruv-muted">
              {link.label}
            </span>
          ))}
        </div>
      )
    }
  </a>
</article>