---
import { site, technologies } from "../config/site";

const [dayStack, nightStack] = technologies;
---

<div class="hero-facts" aria-label="At a glance">
  <div class="hero-fact">
    <span class="hero-fact-value">{site.location}</span>
    <span class="hero-fact-label">Based in</span>
  </div>

  <div class="hero-fact">
    <span class="hero-fact-value hero-fact-status">
      <span class="hero-fact-dot" aria-hidden="true"></span>
      Open to chat
    </span>
    <span class="hero-fact-label">Status</span>
  </div>

  <div class="hero-fact">
    <span class="hero-fact-value">{dayStack}</span>
    <span class="hero-fact-label">At work</span>
  </div>

  <div class="hero-fact">
    <span class="hero-fact-value">{nightStack}</span>
    <span class="hero-fact-label">After hours</span>
  </div>
</div>