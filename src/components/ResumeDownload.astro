---
import { linkPreviewAttributes } from "../lib/link-previews";
import { site } from "../config/site";

const previewAttrs = linkPreviewAttributes(site.resumeUrl);

interface Props {
  variant?: "primary" | "secondary" | "subtle";
  class?: string;
  label?: string;
}

const {
  variant = "secondary",
  class: className,
  label = "Download resume",
} = Astro.props;

const variantClass = {
  primary: "btn-primary",
  secondary: "btn-secondary",
  subtle: "link-subtle",
}[variant];
---

<a
  href={site.resumeUrl}
  download={site.resumeFileName}
  class:list={[variantClass, className]}
  {...previewAttrs}
>
  {label}{variant === "subtle" && " →"}
</a>