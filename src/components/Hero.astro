---
import Fastfetch from "./Fastfetch.astro";
import ResumeDownload from "./ResumeDownload.astro";
import { linkPreviewAttributes } from "../lib/link-previews";
import { site } from "../config/site";

const emailPreview = linkPreviewAttributes(`mailto:${site.email}`);
const codistPreview = linkPreviewAttributes("https://github.com/AbiXnash/codist", {
  title: "Codist",
  description: "Local AI code reviewer for Java/Spring Boot repos.",
  domain: "github.com",
});
---

<section id="home" data-file="README.md" class="pane-section hero-section">
  <div class="pane-outer">
    <div class="pane hero">
      <span class="pane-title">zsh — ~/abx</span>

      <div class="hero-split">
        <div class="hero-main">
          <p class="hero-prompt" aria-hidden="true">
            <span class="sp-dir">~/abx</span>
            <span class="sp-git">git:main</span>
            <span class="sp-go">go 1.24</span>
            <span class="sp-arrow">➜</span>
            <span class="sp-cmd">whoami</span>
          </p>

          <h1 class="hero-title">
            Hey, I'm {site.name.split(" ")[0]}.<br />
            <span class="text-highlight">I build backend software.</span>
          </h1>

          <p class="hero-intro">
            Software engineer at Mindgate, building payment and regulatory
            integrations for banks in Java and Spring Boot. Go and TypeScript
            when the laptop stays open after hours.
          </p>

          <div class="hero-actions">
            <a
              href={`mailto:${site.email}`}
              class="btn-primary hero-btn"
              {...emailPreview}
            >
              Say hello
            </a>
            <ResumeDownload variant="secondary" class="hero-btn" label="Resume" />
          </div>

          <div class="hero-now">
            <p class="hero-now-cmd" aria-hidden="true">
              <span class="sp-arrow">➜</span> cat now.txt
            </p>
            <p class="hero-now-text">
              Building{" "}
              <a href="https://github.com/AbiXnash/codist" target="_blank" rel="noopener noreferrer" {...codistPreview}>Codist</a>,
              a local AI code reviewer for Spring Boot. Nothing leaves your machine.
            </p>
          </div>
        </div>

        <aside class="hero-side">
          <Fastfetch />
        </aside>
      </div>
    </div>
  </div>
</section>
