---
import AtAGlance from "./AtAGlance.astro";
import HeroExperience from "./HeroExperience.astro";
import HeroStackLogos from "./HeroStackLogos.astro";
import Container from "./layout/Container.astro";
import ResumeDownload from "./ResumeDownload.astro";
import { linkPreviewAttributes } from "../lib/link-previews";
import { site } from "../config/site";

const emailPreview = linkPreviewAttributes(`mailto:${site.email}`);
---

<section
  class="hero relative flex min-h-[94vh] flex-col justify-center overflow-hidden pt-32 pb-24 sm:pt-36 sm:pb-28"
>
  <div class="hero-mesh" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <Container>
    <div class="hero-top">
      <div class="hero-content">
        <HeroStackLogos placement="mobile" />

        <p class="hero-caption" aria-hidden="true">
          <span class="hero-caption-prompt">$</span>
          <span>abx --role --current</span>
        </p>

        <h1 class="hero-title">
          Hey, I'm {site.name.split(" ")[0]}.<br />
          <span class="text-gradient-blue">I build backend software.</span>
        </h1>

        <p class="hero-intro">
          Java at Mindgate by day. Payments, banking, the unglamorous stuff
          that has to work. Go and TypeScript experiments when the laptop stays
          open after hours.
        </p>

        <div class="hero-actions">
          <a
            href={`mailto:${site.email}`}
            class="btn-primary hero-btn"
            {...emailPreview}
          >
            Say hello
          </a>
          <ResumeDownload variant="secondary" class="hero-btn" label="Resume" />
        </div>
      </div>

      <HeroStackLogos placement="desktop" />
    </div>

    <AtAGlance />
  </Container>

  <div class="hero-bottom">
    <Container class="flex flex-col items-center gap-[1.125rem] sm:gap-5">
      <HeroExperience />

      <div class="scroll-hint text-gruv-muted" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
    </Container>
  </div>
</section>