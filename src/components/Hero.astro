---
import Container from "./layout/Container.astro";
import { site, socialLinks, technologies } from "../config/site";
---

<section
  class="reveal relative flex min-h-[88vh] flex-col justify-center overflow-hidden pt-28 pb-20"
>
  <div class="hero-mesh" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_320px] lg:gap-16">
      <div class="reveal-stagger relative flex flex-col gap-7">
        <h1 class="display-title max-w-lg">
          Hey, I'm {site.name.split(" ")[0]}.<br />
          <span class="text-gradient">I build backend software.</span>
        </h1>

        <p class="max-w-md text-[1.0625rem] leading-relaxed text-gruv-muted">
          Java at Mindgate by day — payments, banking, the unglamorous stuff
          that has to work. Go and TypeScript experiments when the laptop stays
          open after hours.
        </p>

        <div class="flex flex-wrap items-center gap-5">
          <a href={`mailto:${site.email}`} class="btn-primary">
            Say hello
          </a>
          {
            socialLinks.map((link) => (
              <a href={link.href} target="_blank" class="link-subtle">
                {link.label} →
              </a>
            ))
          }
        </div>
      </div>

      <aside class="reveal-stagger glass-card rounded-[1.75rem] p-5 sm:p-6">
        <p class="eyebrow mb-4">At a glance</p>
        <div class="grid grid-cols-2 gap-3">
          <div class="bento-cell col-span-2 flex items-center justify-between rounded-2xl px-4 py-3.5">
            <span class="text-xs text-gruv-muted">Status</span>
            <span class="flex items-center gap-2 text-sm font-medium text-gruv-text">
              <span class="relative flex h-2 w-2">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-gruv-green opacity-40"
                ></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-gruv-green"
                ></span>
              </span>
              Open to chat
            </span>
          </div>
          <div class="bento-cell flex flex-col gap-1 rounded-2xl px-4 py-3.5">
            <span class="text-xs text-gruv-muted">Focus</span>
            <span class="text-sm font-medium text-gruv-text">{site.focus}</span>
          </div>
          <div class="bento-cell flex flex-col gap-1 rounded-2xl px-4 py-3.5">
            <span class="text-xs text-gruv-muted">Based in</span>
            <span class="text-sm font-medium text-gruv-text">{site.location}</span>
          </div>
          <div class="bento-cell col-span-2 rounded-2xl px-4 py-3.5">
            <span class="text-xs text-gruv-muted">Stack</span>
            <p class="mt-1.5 text-sm leading-relaxed text-gruv-text">
              {technologies.slice(0, 2).join(" · ")}
            </p>
          </div>
        </div>
      </aside>
    </div>
  </Container>

  <div
    class="scroll-hint absolute bottom-8 left-1/2 -translate-x-1/2 text-gruv-muted"
    aria-hidden="true"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </div>
</section>