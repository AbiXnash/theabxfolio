---
import Container from "./Container.astro";
import ResumeDownload from "../ResumeDownload.astro";
import { site, socialLinks } from "../../config/site";

const taglineItems = site.tagline.split(" · ");
---

<footer class="site-footer section-muted border-t border-gruv-border/20">
  <Container class="py-20 sm:py-24">
    <div class="footer-main">
      <div class="footer-intro">
        <p class="display-title text-[2rem] sm:text-[2.25rem]">
          Got something<br />
          <span class="text-gradient">in mind?</span>
        </p>
        <p class="text-sm leading-relaxed text-gruv-muted">
          Happy to talk backend work, side projects, or anything that needs a
          reliable API behind it.
        </p>
        <div class="footer-actions">
          <a href={`mailto:${site.email}`} class="btn-primary footer-email">
            {site.email}
          </a>
          <ResumeDownload variant="secondary" />
        </div>
      </div>

      <div class="footer-aside">
        <div class="footer-social">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                class="text-sm text-gruv-muted transition-colors hover:text-gruv-text"
              >
                {link.label}
              </a>
            ))
          }
        </div>
        <div class="footer-tagline" aria-label={site.tagline}>
          {
            taglineItems.map((item) => (
              <span class="footer-tag">{item}</span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <a href="#" class="transition-colors hover:text-gruv-text">Back to top ↑</a>
    </div>
  </Container>
</footer>