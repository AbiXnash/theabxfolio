---
import Container from "./Container.astro";
import { site, socialLinks } from "../../config/site";
---

<footer class="section-muted border-t border-gruv-border/20">
  <Container class="py-20 sm:py-24">
    <div class="flex flex-col items-start gap-12 sm:flex-row sm:items-end sm:justify-between">
      <div class="flex max-w-sm flex-col gap-4">
        <p class="display-title text-[2rem] sm:text-[2.25rem]">
          Got something<br />
          <span class="text-gradient">in mind?</span>
        </p>
        <p class="text-sm leading-relaxed text-gruv-muted">
          Happy to talk backend work, side projects, or anything that needs a
          reliable API behind it.
        </p>
        <a href={`mailto:${site.email}`} class="btn-primary mt-1 w-fit">
          {site.email}
        </a>
      </div>

      <div class="flex flex-col items-start gap-5 sm:items-end">
        <div class="flex flex-wrap items-center gap-6">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                class="text-sm text-gruv-muted transition-colors hover:text-gruv-text"
              >
                {link.label}
              </a>
            ))
          }
        </div>
        <p class="text-xs text-gruv-muted">{site.tagline}</p>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-gruv-border/15 pt-8 text-xs text-gruv-muted sm:flex-row sm:items-center"
    >
      <span>© {new Date().getFullYear()} {site.name}</span>
      <a href="#" class="transition-colors hover:text-gruv-text">Back to top ↑</a>
    </div>
  </Container>
</footer>