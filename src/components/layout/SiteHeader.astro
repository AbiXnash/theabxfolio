---
import Container from "./Container.astro";
import PreviewLink from "../PreviewLink.astro";
import ThemeToggle from "../ThemeToggle.astro";
import { linkPreviewAttributes } from "../../lib/link-previews";
import { navItems, site, socialLinks } from "../../config/site";

const emailPreview = linkPreviewAttributes(`mailto:${site.email}`);
---

<header id="navbar" class="fixed top-0 right-0 left-0 z-50 border-b border-transparent transition-all duration-300">
  <Container>
    <nav
      id="nav-inner"
      class="glass-nav nav-bar flex h-14 items-center justify-between"
      aria-label="Main navigation"
    >
      <a
        href="/"
        class="nav-brand flex items-center gap-2 text-sm font-medium text-gruv-blue transition-opacity hover:opacity-70"
      >
        <span class="font-semibold">@{site.handle}</span>
      </a>

      <div class="nav-center hidden items-center gap-6 md:flex">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              data-section={item.sectionName}
              class="nav-link text-xs text-gruv-muted transition-colors hover:text-gruv-text"
              {...linkPreviewAttributes(item.href, {
                title: item.sectionName,
              })}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <div class="nav-actions hidden items-center gap-4 md:flex">
        {
          socialLinks.map((link) => (
            <PreviewLink
              href={link.href}
              class="nav-link text-xs text-gruv-muted transition-colors hover:text-gruv-text"
            >
              {link.label}
            </PreviewLink>
          ))
        }
        <a
          href={`mailto:${site.email}`}
          class="nav-cta"
          {...emailPreview}
        >
          Say hello
        </a>
        <ThemeToggle />
      </div>

      <div class="flex items-center gap-3 md:hidden">
        <div class="flex items-center gap-3">
          {
            socialLinks.map((link) => (
              <PreviewLink
                href={link.href}
                class="text-xs text-gruv-muted transition-colors hover:text-gruv-text"
              >
                {link.label}
              </PreviewLink>
            ))
          }
        </div>
        <ThemeToggle />
        <button
          id="menu-toggle"
          type="button"
          class="icon-btn"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="18" x2="20" y2="18"></line>
          </svg>
        </button>
      </div>
    </nav>
  </Container>
</header>

<div
  id="mobile-nav"
  class="mobile-menu pointer-events-none fixed inset-0 z-[60] flex translate-y-[-100%] flex-col opacity-0 transition-all duration-300 md:hidden"
  aria-hidden="true"
  inert
>
  <Container class="flex h-14 items-center justify-end">
    <button
      id="menu-close"
      type="button"
      class="icon-btn"
      aria-label="Close menu"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </Container>

  <nav class="flex flex-1 flex-col items-center justify-center gap-8 pb-24" aria-label="Mobile navigation">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          data-section={item.sectionName}
          class="mobile-link text-3xl font-medium tracking-tight text-gruv-muted transition-colors hover:text-gruv-text"
          {...linkPreviewAttributes(item.href, {
            title: item.sectionName,
          })}
        >
          {item.label}
        </a>
      ))
    }
    <a href={`mailto:${site.email}`} class="btn-primary mt-2" {...emailPreview}>
      Say hello
    </a>
  </nav>
</div>