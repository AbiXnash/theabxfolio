---
import Container from "./Container.astro";
import ThemeToggle from "../ThemeToggle.astro";
import { navItems, site } from "../../config/site";
---

<header id="navbar" class="fixed top-0 right-0 left-0 z-50 px-4 pt-4 transition-all duration-300">
  <Container>
    <nav
      id="nav-inner"
      class="flex h-11 items-center justify-between rounded-2xl px-4 transition-all duration-300 sm:px-5"
      transition:persist
    >
      <a
        href="/"
        class="flex items-center gap-2 text-sm font-medium text-gruv-text transition-opacity hover:opacity-70"
      >
        <span class="text-gradient-blue font-semibold">@{site.handle}</span>
      </a>

      <div class="hidden items-center gap-6 md:flex">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              data-section={item.sectionName}
              class="nav-link text-xs text-gruv-muted transition-colors hover:text-gruv-text"
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={`mailto:${site.email}`}
          class="rounded-full bg-gruv-blue/10 px-2.5 py-1 text-xs font-medium text-gruv-blue transition-colors hover:bg-gruv-blue/15"
        >
          Say hello
        </a>
        <ThemeToggle />
      </div>

      <div class="flex items-center gap-2 md:hidden">
        <ThemeToggle />
        <button
          id="menu-toggle"
          class="text-gruv-text transition-opacity hover:opacity-70"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="18" x2="20" y2="18"></line>
          </svg>
        </button>
      </div>
    </nav>
  </Container>
</header>

<div
  id="mobile-nav"
  class="pointer-events-none fixed inset-0 z-[60] flex translate-y-[-100%] flex-col bg-gruv-bg/95 opacity-0 backdrop-blur-2xl transition-all duration-300 md:hidden"
  aria-hidden="true"
>
  <Container class="flex h-14 items-center justify-end pt-4">
    <button
      id="menu-close"
      class="text-gruv-text transition-opacity hover:opacity-70"
      aria-label="Close menu"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </Container>

  <nav class="flex flex-1 flex-col items-center justify-center gap-8 pb-24">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          data-section={item.sectionName}
          class="mobile-link text-3xl font-medium tracking-tight text-gruv-muted transition-colors hover:text-gruv-text"
        >
          {item.label}
        </a>
      ))
    }
    <a href={`mailto:${site.email}`} class="btn-primary mt-2">
      Say hello
    </a>
  </nav>
</div>