---
import Container from "./Container.astro";
import PreviewLink from "../PreviewLink.astro";
import ThemeToggle from "../ThemeToggle.astro";
import { linkPreviewAttributes } from "../../lib/link-previews";
import { navItems, site, socialLinks } from "../../config/site";

const emailPreview = linkPreviewAttributes(`mailto:${site.email}`);
---

<header id="navbar" class="fixed top-0 right-0 left-0 z-50 border-b border-transparent transition-all duration-300">
  <div class="nav-shell">
    <nav
      id="nav-inner"
      class="glass-nav nav-bar flex h-14 items-center justify-between"
      aria-label="Main navigation"
    >
      <a
        href="/"
        class="nav-brand flex items-center gap-2 font-mono text-sm font-medium text-gruv-text transition-opacity hover:opacity-70"
      >
        <span class="text-gruv-green">~</span>
        <span class="font-semibold">{site.handle}</span>
      </a>

      <div class="nav-center hidden items-center gap-1 md:flex">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              data-section={item.sectionName}
              class="nav-link rounded-sm px-3 py-1.5 font-mono text-xs text-gruv-muted transition-colors hover:text-gruv-text"
              {...linkPreviewAttributes(item.href, {
                title: item.sectionName,
              })}
            >
              <span class="text-gruv-green">./</span>{item.label}
            </a>
          ))
        }
      </div>

      <div class="nav-actions hidden items-center gap-4 md:flex">
        {
          socialLinks.map((link) =>
            link.icon === "github" ? (
              <PreviewLink
                href={link.href}
                class="nav-link nav-social flex items-center text-gruv-muted transition-colors hover:text-gruv-text"
              >
                <svg
                  class="nav-social-icon h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.85 1.24 1.85 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.28 0 .32.21.7.82.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"></path>
                </svg>
              </PreviewLink>
            ) : (
              <PreviewLink
                href={link.href}
                class="nav-link nav-social flex items-center text-gruv-muted transition-colors hover:text-gruv-text"
              >
                <svg
                  class="nav-social-icon h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"></path>
                </svg>
              </PreviewLink>
            ),
          )
        }
        <a
          href={`mailto:${site.email}`}
          class="nav-cta font-mono"
          {...emailPreview}
        >
          Say hello
        </a>
        <ThemeToggle />
      </div>

      <div class="flex items-center gap-3 md:hidden">
        <div class="flex items-center gap-3">
          {
            socialLinks.map((link) =>
              link.icon === "github" ? (
                <PreviewLink
                  href={link.href}
                  class="flex items-center text-gruv-muted transition-colors hover:text-gruv-text"
                >
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.85 1.24 1.85 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.28 0 .32.21.7.82.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"></path>
                  </svg>
                </PreviewLink>
              ) : (
                <PreviewLink
                  href={link.href}
                  class="flex items-center text-gruv-muted transition-colors hover:text-gruv-text"
                >
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"></path>
                  </svg>
                </PreviewLink>
              ),
            )
          }
        </div>
        <ThemeToggle />
        <button
          id="menu-toggle"
          type="button"
          class="icon-btn"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="18" x2="20" y2="18"></line>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<div
  id="mobile-nav"
  class="mobile-menu pointer-events-none fixed inset-0 z-[60] flex translate-y-[-100%] flex-col opacity-0 transition-all duration-300 md:hidden"
  aria-hidden="true"
  inert
>
  <Container class="flex h-14 items-center justify-end">
    <button
      id="menu-close"
      type="button"
      class="icon-btn"
      aria-label="Close menu"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </Container>

  <nav class="flex flex-1 flex-col items-center justify-center gap-8 pb-24" aria-label="Mobile navigation">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          data-section={item.sectionName}
          class="mobile-link text-3xl font-medium tracking-tight text-gruv-muted transition-colors hover:text-gruv-text"
          {...linkPreviewAttributes(item.href, {
            title: item.sectionName,
          })}
        >
          {item.label}
        </a>
      ))
    }
    <a href={`mailto:${site.email}`} class="btn-primary mt-2" {...emailPreview}>
      Say hello
    </a>
  </nav>
</div>