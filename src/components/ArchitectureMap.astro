---
// ArchitectureMap.astro
---

<div class="relative w-full aspect-[4/5] sm:aspect-[21/9] bg-gruv-surface/30 border border-gruv-border/30 rounded-apple overflow-hidden shadow-premium group font-sans">
    
    <!-- SVG Connection Lines -->
    <svg viewBox="0 0 1000 500" class="absolute inset-0 w-full h-full pointer-events-none z-0" preserveAspectRatio="none">
        <defs>
            <linearGradient id="line-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="rgba(254, 128, 25, 0.1)" />
                <stop offset="50%" stop-color="rgba(254, 128, 25, 0.4)" />
                <stop offset="100%" stop-color="rgba(254, 128, 25, 0.1)" />
            </linearGradient>
            <filter id="glow">
                <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
                <feMerge>
                    <feMergeNode in="coloredBlur"/>
                    <feMergeNode in="SourceGraphic"/>
                </feMerge>
            </filter>
        </defs>

        <!-- Base Paths -->
        <g stroke="url(#line-grad)" stroke-width="2" fill="none" stroke-dasharray="6 6" class="opacity-50">
            <path id="p-client-gate" d="M 120 250 L 280 250" />
            <path id="p-gate-svc" d="M 280 250 C 400 250, 420 150, 580 150" />
            <path id="p-gate-work" d="M 280 250 C 400 250, 420 350, 580 350" />
            <path id="p-svc-cache" d="M 580 150 L 880 150" />
            <path id="p-svc-db" d="M 580 150 C 700 150, 740 350, 880 350" />
            <path id="p-work-db" d="M 580 350 L 880 350" />
        </g>

        <!-- Animated Data Packets -->
        <!-- To Gateway -->
        <circle r="4" fill="#fe8019" filter="url(#glow)">
            <animateMotion dur="2s" repeatCount="indefinite"><mpath href="#p-client-gate" /></animateMotion>
        </circle>
        
        <!-- To Services -->
        <circle r="4" fill="#83a598" filter="url(#glow)">
            <animateMotion dur="2.5s" repeatCount="indefinite"><mpath href="#p-gate-svc" /></animateMotion>
        </circle>
        <circle r="3" fill="#83a598" filter="url(#glow)">
            <animateMotion dur="2.5s" begin="1.25s" repeatCount="indefinite"><mpath href="#p-gate-svc" /></animateMotion>
        </circle>

        <!-- To Workers -->
        <circle r="4" fill="#d3869b" filter="url(#glow)">
            <animateMotion dur="3s" repeatCount="indefinite"><mpath href="#p-gate-work" /></animateMotion>
        </circle>

        <!-- Services to Cache -->
        <circle r="3" fill="#b8bb26" filter="url(#glow)">
            <animateMotion dur="1.5s" repeatCount="indefinite"><mpath href="#p-svc-cache" /></animateMotion>
        </circle>
        
        <!-- Services to DB -->
        <circle r="4" fill="#fabd2f" filter="url(#glow)">
            <animateMotion dur="2.2s" repeatCount="indefinite"><mpath href="#p-svc-db" /></animateMotion>
        </circle>

        <!-- Workers to DB -->
        <circle r="4" fill="#fabd2f" filter="url(#glow)">
            <animateMotion dur="2s" repeatCount="indefinite"><mpath href="#p-work-db" /></animateMotion>
        </circle>
    </svg>

    <!-- HTML Nodes -->
    <!-- 1. Client -->
    <div class="absolute transform -translate-x-1/2 -translate-y-1/2 group/node z-10" style="left: 12%; top: 50%;">
        <div class="bg-gruv-bg/90 backdrop-blur-sm border border-gruv-border/40 rounded-xl p-3 sm:p-4 shadow-xl hover:border-gruv-orange hover:shadow-[0_0_20px_rgba(254,128,25,0.3)] transition-all flex flex-col items-center gap-2 cursor-pointer w-20 sm:w-28">
            <svg class="text-gruv-muted group-hover/node:text-gruv-orange transition-colors" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            <span class="text-[10px] sm:text-xs font-bold text-gruv-text uppercase tracking-widest">Client</span>
        </div>
    </div>

    <!-- 2. API Gateway -->
    <div class="absolute transform -translate-x-1/2 -translate-y-1/2 group/node z-10" style="left: 28%; top: 50%;">
        <div class="bg-gruv-bg/90 backdrop-blur-sm border border-gruv-border/40 rounded-xl p-3 sm:p-4 shadow-xl hover:border-gruv-blue hover:shadow-[0_0_20px_rgba(131,165,152,0.3)] transition-all flex flex-col items-center gap-2 cursor-pointer w-20 sm:w-28 relative">
            <svg class="text-gruv-muted group-hover/node:text-gruv-blue transition-colors" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
            <span class="text-[10px] sm:text-xs font-bold text-gruv-text uppercase tracking-widest">Gateway</span>
            <!-- Tooltip -->
            <div class="absolute bottom-full mb-4 left-1/2 -translate-x-1/2 w-max opacity-0 pointer-events-none group-hover/node:opacity-100 transition-opacity bg-gruv-surface border border-gruv-border rounded-lg px-3 py-2 shadow-2xl z-20">
                <p class="text-xs font-mono text-gruv-muted">Kong / Nginx</p>
                <p class="text-[10px] text-gruv-orange mt-1">Rate Limiting, Auth, Routing</p>
            </div>
        </div>
    </div>

    <!-- 3. Core Services -->
    <div class="absolute transform -translate-x-1/2 -translate-y-1/2 group/node z-10" style="left: 58%; top: 30%;">
        <div class="bg-gruv-bg/90 backdrop-blur-sm border border-gruv-border/40 rounded-xl p-3 sm:p-4 shadow-xl hover:border-gruv-aqua hover:shadow-[0_0_20px_rgba(142,192,124,0.3)] transition-all flex flex-col items-center gap-2 cursor-pointer w-24 sm:w-32 relative">
            <svg class="text-gruv-muted group-hover/node:text-gruv-aqua transition-colors" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            <span class="text-[10px] sm:text-xs font-bold text-gruv-text uppercase tracking-widest">Services</span>
            <!-- Tooltip -->
            <div class="absolute bottom-full mb-4 left-1/2 -translate-x-1/2 w-max opacity-0 pointer-events-none group-hover/node:opacity-100 transition-opacity bg-gruv-surface border border-gruv-border rounded-lg px-3 py-2 shadow-2xl z-20 text-center">
                <p class="text-xs font-mono text-gruv-muted">Java / Go / TS</p>
                <p class="text-[10px] text-gruv-aqua mt-1">gRPC, REST, Business Logic</p>
            </div>
        </div>
    </div>

    <!-- 4. Background Workers -->
    <div class="absolute transform -translate-x-1/2 -translate-y-1/2 group/node z-10" style="left: 58%; top: 70%;">
        <div class="bg-gruv-bg/90 backdrop-blur-sm border border-gruv-border/40 rounded-xl p-3 sm:p-4 shadow-xl hover:border-gruv-purple hover:shadow-[0_0_20px_rgba(211,134,155,0.3)] transition-all flex flex-col items-center gap-2 cursor-pointer w-24 sm:w-32 relative">
            <svg class="text-gruv-muted group-hover/node:text-gruv-purple transition-colors" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect><rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
            <span class="text-[10px] sm:text-xs font-bold text-gruv-text uppercase tracking-widest text-center">Workers</span>
            <!-- Tooltip -->
            <div class="absolute bottom-full mb-4 left-1/2 -translate-x-1/2 w-max opacity-0 pointer-events-none group-hover/node:opacity-100 transition-opacity bg-gruv-surface border border-gruv-border rounded-lg px-3 py-2 shadow-2xl z-20 text-center">
                <p class="text-xs font-mono text-gruv-muted">Kafka / RabbitMQ</p>
                <p class="text-[10px] text-gruv-purple mt-1">Async Processing, Cron</p>
            </div>
        </div>
    </div>

    <!-- 5. Cache -->
    <div class="absolute transform -translate-x-1/2 -translate-y-1/2 group/node z-10" style="left: 88%; top: 30%;">
        <div class="bg-gruv-bg/90 backdrop-blur-sm border border-gruv-border/40 rounded-xl p-3 sm:p-4 shadow-xl hover:border-gruv-green hover:shadow-[0_0_20px_rgba(184,187,38,0.3)] transition-all flex flex-col items-center gap-2 cursor-pointer w-20 sm:w-28 relative">
            <svg class="text-gruv-muted group-hover/node:text-gruv-green transition-colors" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
            <span class="text-[10px] sm:text-xs font-bold text-gruv-text uppercase tracking-widest">Cache</span>
            <!-- Tooltip -->
            <div class="absolute bottom-full mb-4 left-1/2 -translate-x-1/2 w-max opacity-0 pointer-events-none group-hover/node:opacity-100 transition-opacity bg-gruv-surface border border-gruv-border rounded-lg px-3 py-2 shadow-2xl z-20 text-center">
                <p class="text-xs font-mono text-gruv-muted">Redis / Memcached</p>
                <p class="text-[10px] text-gruv-green mt-1">Sub-ms Latency</p>
            </div>
        </div>
    </div>

    <!-- 6. Database -->
    <div class="absolute transform -translate-x-1/2 -translate-y-1/2 group/node z-10" style="left: 88%; top: 70%;">
        <div class="bg-gruv-bg/90 backdrop-blur-sm border border-gruv-border/40 rounded-xl p-3 sm:p-4 shadow-xl hover:border-gruv-yellow hover:shadow-[0_0_20px_rgba(250,189,47,0.3)] transition-all flex flex-col items-center gap-2 cursor-pointer w-20 sm:w-28 relative">
            <svg class="text-gruv-muted group-hover/node:text-gruv-yellow transition-colors" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
            <span class="text-[10px] sm:text-xs font-bold text-gruv-text uppercase tracking-widest text-center">Database</span>
            <!-- Tooltip -->
            <div class="absolute bottom-full mb-4 left-1/2 -translate-x-1/2 w-max opacity-0 pointer-events-none group-hover/node:opacity-100 transition-opacity bg-gruv-surface border border-gruv-border rounded-lg px-3 py-2 shadow-2xl z-20 text-center">
                <p class="text-xs font-mono text-gruv-muted">PostgreSQL</p>
                <p class="text-[10px] text-gruv-yellow mt-1">ACID, Partitioning</p>
            </div>
        </div>
    </div>
</div>
