---
import Container from "./layout/Container.astro";
import SectionHeader from "./layout/SectionHeader.astro";
import RepoFeedSkeleton from "./RepoFeedSkeleton.astro";
---

<Container>
  <SectionHeader
    eyebrow="Open Source"
    title="On GitHub."
    description="What I pushed most recently, straight from the GitHub API."
    href="https://github.com/AbiXnash"
    linkLabel="View profile"
  />

  <div class="glog-term">
    <p class="glog-cmd" aria-hidden="true">
      <span class="sp-dir">~/abx</span>
      <span class="sp-arrow">➜</span>
      <span class="glog-cmd-text">gh repo list AbiXnash --sort pushed</span>
    </p>

    <div
      id="repos-feed"
      role="region"
      aria-label="GitHub repositories"
      aria-busy="true"
    >
      <RepoFeedSkeleton />
    </div>

    <p id="repos-error" class="glog-error hidden">
      <span class="text-hp-love">error:</span> couldn't reach the GitHub API.
      <a href="https://github.com/AbiXnash" target="_blank" rel="noopener noreferrer">Open the profile ↗</a>
    </p>
  </div>
</Container>
