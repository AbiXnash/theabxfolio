---
import Container from "./layout/Container.astro";
import SectionHeader from "./layout/SectionHeader.astro";
import RepoFeedSkeleton from "./RepoFeedSkeleton.astro";
---

<Container>
  <SectionHeader
    eyebrow="Open Source"
    title="On GitHub."
    description="Public repos, sorted by latest push."
    href="https://github.com/AbiXnash"
    linkLabel="View profile"
  />

  <div
    id="repos-feed"
    aria-busy="true"
    aria-label="Loading repositories"
  >
    <RepoFeedSkeleton />
  </div>

  <p id="repos-error" class="hidden py-14 text-center text-sm text-gruv-muted">
    Failed to load repositories.
  </p>
</Container>

<script>
  import { loadRepos } from "../scripts/repos";

  loadRepos().finally(() => {
    document.getElementById("repos-feed")?.removeAttribute("aria-busy");
  });
</script>