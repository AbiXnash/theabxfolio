---
import Container from "./layout/Container.astro";
import SectionHeader from "./layout/SectionHeader.astro";
import RepoFeedSkeleton from "./RepoFeedSkeleton.astro";
---

<Container>
  <SectionHeader
    eyebrow="Open Source"
    title="On GitHub."
    description="Public repos, sorted by latest push."
    href="https://github.com/AbiXnash"
    linkLabel="View profile"
  />

  <div
    id="repos-feed"
    role="region"
    aria-label="GitHub repositories"
    aria-busy="true"
  >
    <RepoFeedSkeleton />
  </div>

  <p id="repos-error" class="hidden py-14 text-center text-sm text-gruv-muted">
    Failed to load repositories.
  </p>
</Container>

