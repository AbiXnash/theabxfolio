<div class="glog" aria-hidden="true">
  <div class="glog-rows">
    {
      Array.from({ length: 4 }).map(() => (
        <div class="glog-row pointer-events-none">
          <span class="glog-graph"><span class="glog-node" /></span>
          <span class="glog-head"><span class="skeleton block h-3.5 w-28 rounded-sm" /></span>
          <span class="glog-desc"><span class="skeleton block h-3 w-full max-w-[18rem] rounded-sm" /></span>
          <span class="glog-meta">
            <span class="skeleton block h-3 w-14 rounded-sm" />
            <span class="skeleton block h-3 w-16 rounded-sm" />
            <span class="skeleton block h-3 w-12 rounded-sm" />
          </span>
        </div>
      ))
    }
  </div>
  <p class="glog-summary"><span class="skeleton block h-3 w-48 rounded-sm" /></p>
</div>
