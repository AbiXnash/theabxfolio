---
import { getLanguageColor, timeAgo, type Repo } from "../lib/repos";

interface Props {
  repo: Repo;
}

const { repo } = Astro.props;
const langColor = getLanguageColor(repo.language);
const ago = timeAgo(repo.pushedAt);
---

<a
  href={repo.url}
  target="_blank"
  class="tile-card group flex h-full min-h-[240px] flex-col gap-4 rounded-[1.75rem] p-6 sm:min-h-[260px] sm:p-8"
>
  <div class="flex items-center justify-between gap-4">
    {
      repo.language ? (
        <span class="flex items-center gap-2 text-xs text-gruv-muted">
          <span
            class="h-1.5 w-1.5 rounded-full"
            style={`background-color: ${langColor}`}
          />
          {repo.language}
        </span>
      ) : (
        <span class="text-xs text-gruv-muted">Repository</span>
      )
    }
    <svg
      class="ml-auto shrink-0 text-gruv-muted opacity-0 transition-opacity group-hover:opacity-100"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
      <polyline points="15 3 21 3 21 9"></polyline>
      <line x1="10" y1="14" x2="21" y2="3"></line>
    </svg>
  </div>

  <h4 class="text-xl font-semibold tracking-tight">{repo.name}</h4>

  {
    repo.description && (
      <p class="line-clamp-2 flex-1 text-sm leading-relaxed text-gruv-muted">
        {repo.description}
      </p>
    )
  }

  <div class="mt-auto flex items-center gap-3 text-xs text-gruv-muted">
    <span>{repo.commits} commits</span>
    <span class="text-gruv-border/60">·</span>
    <span>{ago}</span>
  </div>
</a>