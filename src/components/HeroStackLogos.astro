---
import { heroStackLogos } from "../lib/hero-stack";

interface Props {
  placement?: "desktop" | "mobile";
}

const { placement = "desktop" } = Astro.props;
---

<div
  class:list={[
    "hero-stack-logos",
    placement === "mobile" ? "hero-stack-logos--mobile" : "hero-stack-logos--desktop",
  ]}
  aria-label="Spring Boot, Golang, and TypeScript"
>
  {
    heroStackLogos.map((logo) => (
      <div
        class:list={["hero-stack-logo-item", logo.className]}
        title={logo.name}
      >
        <span class="hero-stack-logo-tip">{logo.name}</span>
        <svg
          class="hero-stack-logo"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path fill="currentColor" d={logo.path} />
        </svg>
      </div>
    ))
  }
</div>