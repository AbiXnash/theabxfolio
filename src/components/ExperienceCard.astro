---
interface Props {
  title: string;
  meta: string;
  intro: string;
  details: string;
  skills?: string[];
  category?: string;
  index?: number;
}

const { title, meta, intro, details, skills, category, index } = Astro.props;
const num = index !== undefined ? String(index + 1).padStart(2, "0") : null;
---

<article class="tile-card group rounded-[1.75rem] p-6 sm:p-8">
  <div
    class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-start"
  >
    <div class="flex items-start gap-4">
      {
        num && (
          <span class="mt-0.5 font-mono text-xs text-gruv-muted/60">{num}</span>
        )
      }
      <div class="flex flex-col gap-1.5">
        <h4 class="text-xl font-semibold tracking-tight">{title}</h4>
        <span class="text-sm text-gruv-muted">{meta}</span>
      </div>
    </div>
    {
      category && (
        <span class="shrink-0 rounded-full bg-gruv-blue/10 px-3 py-1 text-xs font-medium text-gruv-blue">
          {category}
        </span>
      )
    }
  </div>

  <p class="mb-6 text-[1.0625rem] leading-relaxed text-gruv-muted">{intro}</p>

  <ul class="mb-6 flex flex-col gap-3">
    {
      details
        .split("\n")
        .filter((line) => line.startsWith("-"))
        .map((line) => (
          <li class="flex items-start gap-3 text-sm leading-relaxed text-gruv-muted">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-gruv-blue/50" />
            <span>{line.replace("- ", "")}</span>
          </li>
        ))
    }
  </ul>

  {
    skills && skills.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {skills.map((skill) => (
          <span class="rounded-full border border-gruv-border/20 bg-gruv-bg px-3 py-1 text-xs text-gruv-muted transition-colors group-hover:border-gruv-border/40">
            {skill}
          </span>
        ))}
      </div>
    )
  }
</article>