---
import TechLogos from "./TechLogos.astro";
import { site } from "../config/site";
import { splitSkills } from "../lib/tech-logos";

interface Props {
  title: string;
  meta: string;
  intro: string;
  details: string;
  skills?: string[];
  category?: string;
}

const { title, meta, intro, details, skills, category } = Astro.props;

const atIndex = title.indexOf(" at ");
const role = atIndex === -1 ? title : title.slice(0, atIndex);
const company = atIndex === -1 ? "" : title.slice(atIndex + 4);

const detailItems = details
  .split("\n")
  .filter((line) => line.startsWith("-"))
  .map((line) => line.replace("- ", ""));

const { logos, labels } = splitSkills(skills ?? []);
---

<article class="entry">
  <header class="entry-header">
    {
      (category || meta) && (
        <p class="entry-meta">
          {[category, meta].filter(Boolean).join(" · ")}
        </p>
      )
    }
    <h3 class="entry-title">{role}</h3>
    {
      company && (
        <a
          class="entry-employer"
          href={site.employerUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          @{company}
        </a>
      )
    }
  </header>

  <p class="entry-intro">{intro}</p>

  {
    detailItems.length > 0 && (
      <ul class="entry-highlights">
        {detailItems.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }

  {
    (logos.length > 0 || labels.length > 0) && (
      <div class="entry-stack">
        <TechLogos logos={logos} />
        {labels.map((skill) => (
          <span class="entry-stack-item">{skill}</span>
        ))}
      </div>
    )
  }
</article>