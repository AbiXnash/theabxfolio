---
import PreviewLink from "./PreviewLink.astro";
import { site } from "../config/site";

interface Props {
  title: string;
  meta: string;
  intro: string;
  details: string;
  skills?: string[];
  category?: string;
}

const { title, meta, intro, details, skills, category } = Astro.props;

const atIndex = title.indexOf(" at ");
const role = atIndex === -1 ? title : title.slice(0, atIndex);
const company = atIndex === -1 ? "" : title.slice(atIndex + 4);

const detailItems = details
  .split("\n")
  .filter((line) => line.startsWith("-"))
  .map((line) => line.replace("- ", ""));

---

<article class="entry">
  <header class="entry-header">
    {
      (category || meta) && (
        <p class="entry-meta">
          {[category, meta].filter(Boolean).join(" · ")}
        </p>
      )
    }
    <h3 class="entry-title">{role}</h3>
    {
      company && (
        <PreviewLink class="entry-employer" href={site.employerUrl}>
          @{company}
        </PreviewLink>
      )
    }
  </header>

  <p class="entry-intro">{intro}</p>

  {
    detailItems.length > 0 && (
      <ul class="entry-highlights">
        {detailItems.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }

  {
    skills && skills.length > 0 && (
      <div class="entry-stack">
        {skills.map((skill) => (
          <span class="entry-stack-item">{skill}</span>
        ))}
      </div>
    )
  }
</article>