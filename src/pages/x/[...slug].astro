---
import goModules from "../../data/go-modules.json";

export async function getStaticPaths() {
  return Object.keys(goModules).map((module) => ({
    params: { slug: module },
  }));
}

const modulePath = Astro.params.slug!;
const repo = goModules[modulePath as keyof typeof goModules];

if (!repo) {
  return Astro.redirect("/404", 404);
}

const importPath = `theabx.in/x/${modulePath}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="go-import" content={`${importPath} git ${repo}`} />
    <meta http-equiv="refresh" content={`0; url=${repo}`} />
    <title>theabx.in/x/{modulePath}</title>
  </head>
  <body>
    <p>
      Go module: <code>theabx.in/x/{modulePath}</code>
    </p>
    <p>
      Source: <a href={repo}>{repo}</a>
    </p>
  </body>
</html>
