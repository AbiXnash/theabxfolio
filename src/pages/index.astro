---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import SectionHeader from '../components/layout/SectionHeader.astro';
import OpenSourceSection from '../components/OpenSourceSection.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { technologies } from '../config/site';

const resumeEntry = await getEntry('resume', 'resume');

if (!resumeEntry) {
    throw new Error('Could not find resume data in content collection. ID used: resume');
}

const { work, projects, education } = resumeEntry.data;

const currentRole = work.items[0];

const skills = [...new Set(work.items.flatMap(w => w.skills ?? []))];

const featuredTech = ["Spring Boot", "Golang"];
const otherTech = technologies.filter(t => !featuredTech.includes(t));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Abinash Selvarasu",
  givenName: "Abinash",
  familyName: "Selvarasu",
  jobTitle: currentRole?.title ?? "Backend Engineer",
  description: "Backend engineer working with Java, Go, and payment systems.",
  url: "https://theabx.in",
  email: "abinash@theabx.in",
  image: "https://theabx.in/og-image.svg",
  sameAs: [
    "https://github.com/AbiXnash",
    "https://instagram.com/abx.engg",
  ],
  knowsAbout: skills,
  worksFor: currentRole
    ? {
        "@type": "Organization",
        name: currentRole.title.split("—").pop()?.trim() ?? "Mindgate Solutions",
      }
    : undefined,
  alumniOf: education.items.map(e => ({
    "@type": "EducationalOrganization",
    name: e.title.split("—").pop()?.trim() ?? e.title,
  })),
};
---

<BaseLayout
  title="Abinash Selvarasu | Backend Engineer"
  description={jsonLd.description}
  jsonLd={jsonLd}
>
  <Hero />

  <Section id="experience" tone="muted">
    <Container>
      <SectionHeader
        eyebrow="Experience"
        title="The day job."
        description="Payment systems and banking tools — the kind of software that can't break on a Friday."
      />

      <div class="flex flex-col gap-5">
        {work.items.map((item, index) => (
          <ExperienceCard {...item} index={index} />
        ))}
      </div>

      <p class="mt-8 text-xs leading-relaxed text-gruv-muted/70">
        Public summary only. Client details kept intentionally vague.
      </p>
    </Container>
  </Section>

  <Section id="projects">
    <Container>
      <SectionHeader
        eyebrow="Projects"
        title="Built after hours."
        description="Side projects and experiments — the fun stuff."
        href="https://github.com/AbiXnash"
        linkLabel="All on GitHub"
      />

      <div id="projects-grid" class="grid grid-cols-1 items-stretch gap-5 md:grid-cols-2">
        {projects.items.map((item, index) => (
          <div class={`project-item h-full ${index >= 4 ? 'hidden' : ''}`}>
            <ProjectCard {...item} />
          </div>
        ))}
      </div>

      {projects.items.length > 4 && (
        <div class="mt-12 flex justify-center">
          <button
            id="load-more-projects"
            class="cursor-pointer rounded-full border border-gruv-border/25 px-6 py-2.5 text-sm text-gruv-muted transition-all hover:border-gruv-blue/25 hover:text-gruv-text"
          >
            Show more
          </button>
        </div>
      )}
    </Container>
  </Section>

  <Section id="opensource" tone="muted">
    <OpenSourceSection />
  </Section>

  <Section id="toolkit" spacing="compact">
    <Container>
      <SectionHeader
        eyebrow="Toolkit"
        title="What's in the stack."
        description="Languages and tools I actually reach for."
      />

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-6">
        {featuredTech.map((tech) => (
          <div class="tile-card col-span-1 flex flex-col justify-end rounded-[1.75rem] p-5 sm:col-span-2 sm:p-6">
            <span class="text-lg font-semibold tracking-tight text-gruv-text">{tech}</span>
            <span class="mt-1 text-xs text-gruv-muted">Core</span>
          </div>
        ))}
        {otherTech.map((tech) => (
          <div class="bento-cell col-span-1 flex items-center justify-center rounded-2xl px-3 py-4 sm:col-span-1">
            <span class="text-xs font-medium text-gruv-muted">{tech}</span>
          </div>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>

<script>
  import { setupProjects } from '../scripts/projects';

  setupProjects();
  document.addEventListener('astro:page-load', setupProjects);
</script>