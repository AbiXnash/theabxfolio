---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import SectionHeader from '../components/layout/SectionHeader.astro';
import OpenSourceSection from '../components/OpenSourceSection.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import PublicationsSection from '../components/PublicationsSection.astro';
import PaymentFlow from '../components/PaymentFlow.astro';
import { site, sameAs, technologies, techKinds } from '../config/site';

const resumeEntry = await getEntry('resume', 'resume');

if (!resumeEntry) {
    throw new Error('Could not find resume data in content collection. ID used: resume');
}

const { work, projects, publications, education } = resumeEntry.data;

const skills = [...new Set(work.items.flatMap((w) => w.skills ?? []))];

const featuredTech = ["Spring Boot", "Golang"];
const otherTech = technologies.filter(t => !featuredTech.includes(t));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  givenName: "Abinash",
  familyName: "Selvarasu",
  jobTitle: site.role,
  description: site.description,
  url: site.domain,
  email: site.email,
  image: `${site.domain}/og-image.svg`,
  sameAs: [...sameAs],
  knowsAbout: [...technologies, ...skills],
  worksFor: {
    "@type": "Organization",
    name: site.employer,
  },
  subjectOf: publications.items.map((p) => ({
    "@type": "ScholarlyArticle",
    headline: p.title,
    author: p.authors.map((name) => ({ "@type": "Person", name })),
    datePublished: String(p.year),
    isPartOf: p.venue,
    sameAs: `https://doi.org/${p.doi}`,
  })),
  alumniOf: education.items.map((e) => ({
    "@type": "EducationalOrganization",
    name: e.title.split(",").pop()?.trim() ?? e.title,
  })),
};
---

<BaseLayout
  title="Abinash Selvarasu | Software Engineer"
  description={jsonLd.description}
  jsonLd={jsonLd}
>
  <Hero />

  <Section id="experience" file="work.md">
    <Container>
      <SectionHeader
        eyebrow="Experience"
        title="The day job."
        description="Payment systems and banking tools. The kind of software that can't break on a Friday."
        href={site.resumeUrl}
        linkLabel="View resume"
        download
      />

      <div class="exp-layout">
        <div class="entry-list">
          {work.items.map((item) => (
            <ExperienceCard {...item} />
          ))}
        </div>
        <PaymentFlow />
      </div>

      <p class="mt-8 text-xs leading-relaxed text-gruv-muted/70">
        Public summary only. Client details kept intentionally vague.
      </p>
    </Container>
  </Section>

  <ProjectsSection items={projects.items} />

  <PublicationsSection items={publications.items} />

  <Section id="opensource" file="activity.log">
    <OpenSourceSection />
  </Section>

  <Section id="toolkit" file="stack.toml" spacing="compact">
    <Container>
      <SectionHeader
        eyebrow="Toolkit"
        title="What's in the stack."
        description="Languages and tools I actually reach for."
      />

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-6">
        {featuredTech.map((tech) => (
          <div class="tile-card col-span-1 flex flex-col justify-end rounded-md p-5 sm:col-span-2 sm:p-6">
            <span class="font-mono text-lg font-semibold tracking-tight text-gruv-text">{tech}</span>
            <span class="mt-1 font-mono text-xs text-gruv-green">Core</span>
          </div>
        ))}
        {otherTech.map((tech) => (
          <div class="bento-cell col-span-1 flex flex-col items-center justify-center gap-1 rounded-sm px-3 py-4 sm:col-span-1">
            <span class="font-mono text-xs font-medium text-gruv-text">{tech}</span>
            {techKinds[tech] && (
              <span class="font-mono text-[10px] text-gruv-muted/70">{techKinds[tech]}</span>
            )}
          </div>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>

