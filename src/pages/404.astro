---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
---

<BaseLayout
  title="Page Not Found | Abinash Selvarasu"
  description="The page you're looking for doesn't exist."
  hideNavAndFooter={true}
>
  <Container narrow class="flex flex-col items-center gap-6 py-20 text-center sm:py-28">
    <p class="eyebrow">404</p>
    <h1 class="display-title">This page doesn't exist.</h1>
    <p class="max-w-md text-[1.0625rem] leading-relaxed text-gruv-muted">
      The page you're looking for may have been moved or removed.
    </p>
    <a href="/" class="btn-primary mt-2">Back to home</a>
  </Container>
</BaseLayout>