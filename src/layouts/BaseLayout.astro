---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface SocialLink {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  socialLinks?: SocialLink[];
  jsonLd?: Record<string, unknown>;
  hideNavAndFooter?: boolean;
}

const {
  title,
  description = "Portfolio of Abinash Selvarasu — Backend engineer working with Java, Go, and payment systems.",
  ogImage = "/og-image.svg",
  canonicalURL = "https://theabx.in",
  socialLinks = [],
  jsonLd,
  hideNavAndFooter = false,
} = Astro.props;

const generateLogs = (count: number) => {
  return Array.from({ length: count }).map(() => {
    const timestamp = new Date(Date.now() - Math.random() * 10000000).toISOString().replace('T', ' ').substring(0, 23);
    const levels = ["INFO", "WARN", "DEBUG", "ERROR", "TRACE"];
    const level = levels[Math.floor(Math.random() * levels.length)];
    const processes = ["postgres", "redis", "nginx", "node", "docker", "kernel", "wasm"];
    const process = processes[Math.floor(Math.random() * processes.length)];
    const messages = [
      "Connection established successfully.",
      "Replication lag detected at 45ms.",
      "Starting worker process...",
      "Memory usage exceeds 80%. Garbage collection initiated.",
      "Flushing buffers to disk...",
      "Health check passed. Container ready.",
      "10101001 01010100 10101011 11001010",
      "01100110 01101111 01101111 01100010",
      "Handshake failed with peer. Retrying...",
      "Executing query: SELECT * FROM users;",
      "Cache miss for key user:session:9842",
      "Allocating 256MB for incoming buffer.",
      "Segmentation fault (core dumped)..."
    ];
    const msg = messages[Math.floor(Math.random() * messages.length)];
    const marginLeft = Math.floor(Math.random() * 40); // 0 to 40% margin
    return { text: `[${timestamp}] [${level}] [${process}] ${msg}`, marginLeft };
  });
};

const slowLogs = generateLogs(120);
const mediumLogs = generateLogs(80);
const fastLogs = generateLogs(50);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
