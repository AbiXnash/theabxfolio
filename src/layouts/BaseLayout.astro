---
import ResumeModal from "../components/ResumeModal.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import StatusLine from "../components/layout/StatusLine.astro";
import Explorer from "../components/layout/Explorer.astro";
import BootScreen from "../components/layout/BootScreen.astro";
import { site } from "../config/site";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  jsonLd?: Record<string, unknown>;
  hideNavAndFooter?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = "/og-image.svg",
  canonicalURL = site.domain,
  jsonLd,
  hideNavAndFooter = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href={site.workerUrl} crossorigin />
    <meta name="theme-color" content="#faf4ed" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16181d" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site.domain}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={site.name} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${site.domain}${ogImage}`} />

    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}

    <style is:inline>
      html { background-color: #faf4ed; color-scheme: light; }
      html.dark { background-color: #141416; color-scheme: dark; }
    </style>

    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        const root = document.documentElement;
        if (theme === "dark") root.classList.add("dark");
        root.style.backgroundColor = theme === "dark" ? "#141416" : "#faf4ed";
        root.classList.add("js");

        // First-visit boot screen (see BootScreen.astro). Decided before paint to avoid a flash.
        try {
          const force = /[?&]boot\b/.test(location.search);
          const seen = localStorage.getItem("abx-booted") === "1";
          const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if ((force || !seen) && !reduce) root.classList.add("boot");
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={["min-h-screen text-gruv-text antialiased", !hideNavAndFooter && "has-shell"]}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    {!hideNavAndFooter && <SiteHeader />}
    {!hideNavAndFooter && <Explorer />}

    {
      hideNavAndFooter && (
        <header class="fixed top-0 right-0 left-0 z-50 border-b border-transparent">
          <div class="page-shell flex h-14 items-center justify-end">
            <ThemeToggle />
          </div>
        </header>
      )
    }

    <main
      id="main-content"
      tabindex="-1"
      class:list={[
        hideNavAndFooter && "flex min-h-screen items-center justify-center",
      ]}
    >
      <slot />
    </main>

    {!hideNavAndFooter && <SiteFooter />}
    {!hideNavAndFooter && <StatusLine />}
    {!hideNavAndFooter && <BootScreen />}

    <ResumeModal />

    <script>
      import { setupLinkPreviews } from "../scripts/link-preview";
      import { setupMotion } from "../scripts/motion";
      import { setupSmoothScroll } from "../scripts/smooth-scroll";
      import { setupReposFeed } from "../scripts/repos";
      import { setupResumeModal } from "../scripts/resume-modal";
      import { setupReveals } from "../scripts/reveals";
      import { setupSite } from "../scripts/site";
      import { setupThemeToggle } from "../scripts/theme";

      function setup() {
        setupThemeToggle();
        setupReveals();
        setupMotion();
        setupSmoothScroll();
        setupLinkPreviews();
        setupReposFeed();
        setupResumeModal();
        if (!document.getElementById("navbar")) return;
        setupSite();
      }

      setup();
    </script>
  </body>
</html>