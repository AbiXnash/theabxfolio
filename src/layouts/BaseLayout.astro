      <!-- Layer 1: Background (Slow, Small, Dim, Green) -->
      <div class="absolute inset-0 font-mono text-[8px] opacity-10 text-[var(--color-gruv-green)] animate-scroll-slow whitespace-nowrap flex flex-col">
        {slowLogs.map(log => <div class="py-[2px]" style={`margin-left: ${log.marginLeft}%`}>{log.text} {log.text}</div>)}
