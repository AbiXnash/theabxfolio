---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface SocialLink {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  socialLinks?: SocialLink[];
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = "Portfolio of Abinash Selvarasu — Backend engineer working with Java, Go, and payment systems.",
  ogImage = "/og-image.svg",
  canonicalURL = "https://theabx.in",
  socialLinks = [],
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`https://theabx.in${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Abinash Selvarasu" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`https://theabx.in${ogImage}`} />

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="text-gruv-text min-h-screen antialiased">
    <div class="film-grain"></div>
    <div id="spotlight-cursor" class="pointer-events-none fixed z-[-5] opacity-0 transition-opacity duration-500 will-change-[left,top]">
      <div class="absolute -translate-x-1/2 -translate-y-1/2 rounded-full blur-[100px]" style="width: 40vw; height: 40vw; background: radial-gradient(circle, rgba(254,128,25,0.15) 0%, transparent 70%);"></div>
    </div>
    <div class="bg-illusion">
      <div class="bg-illusion-grid"></div>
      <div class="bg-illusion-mask"></div>
    </div>


    <!-- Scroll progress bar -->
    <div id="scroll-bar" class="fixed top-0 left-0 z-[60] h-0.5 bg-gruv-orange transition-all duration-150" style="width: 0%"></div>

    <!-- Personal Portfolio Navbar -->
    <nav
      id="navbar"
      class="fixed top-0 right-0 left-0 z-50 h-16 border-b border-gruv-border/30 transition-all duration-500"
      transition:persist
    >
      <div
        class="mx-auto flex h-full max-w-6xl items-center justify-between px-6"
      >
        <div class="flex items-center gap-3">
          <a href="/" class="group flex items-center gap-2">
            <span
              class="text-gruv-text group-hover:text-gruv-orange text-lg font-bold tracking-tight transition-colors"
              >abx <span class="text-gruv-muted font-normal">//</span> dev</span
            >
          </a>
          <div class="bg-gruv-border/50 hidden h-4 w-[1px] sm:block"></div>
          <span
            class="text-gruv-muted hidden text-[10px] font-bold tracking-widest uppercase sm:block"
          >
            Software Engineer
          </span>
        </div>

        <!-- Desktop Links -->
        <div
          class="hidden items-center gap-1 text-xs font-bold tracking-widest uppercase md:flex"
        >
          <a
            href="#experience"
            data-section="Work"
            class="nav-link text-gruv-muted hover:text-gruv-text hover:bg-gruv-surface/50 rounded-lg px-4 py-2 transition-all"
            >Work</a
          >
          <a
            href="#projects"
            data-section="Projects"
            class="nav-link text-gruv-muted hover:text-gruv-text hover:bg-gruv-surface/50 rounded-lg px-4 py-2 transition-all"
            >Projects</a
          >
          <a
            href="#education"
            data-section="Education"
            class="nav-link text-gruv-muted hover:text-gruv-text hover:bg-gruv-surface/50 rounded-lg px-4 py-2 transition-all"
            >Education</a
          >
          <a
            href="#opensource"
            data-section="Open Source"
            class="nav-link text-gruv-muted hover:text-gruv-text hover:bg-gruv-surface/50 rounded-lg px-4 py-2 transition-all"
            >Activity</a
          >
          <a
            href="mailto:abinash@theabx.in"
            class="text-gruv-orange hover:bg-gruv-orange/10 flex items-center gap-2 rounded-lg px-4 py-2 transition-all"
          >
            Email
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              ><line x1="22" y1="2" x2="11" y2="13"></line><polyline
                points="22 2 15 22 11 13 2 9 22 2"></polyline></svg
            >
          </a>
        </div>

        <!-- Mobile Toggle -->
        <button
          id="menu-toggle"
          class="text-gruv-text hover:bg-gruv-surface/50 rounded-lg p-2 transition-colors md:hidden"
          aria-label="Toggle Menu"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><line x1="3" y1="12" x2="21" y2="12"></line><line
              x1="3"
              y1="6"
              x2="21"
              y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg
          >
        </button>
      </div>
    </nav>

    <!-- Mobile Bottom Drawer Overlay -->
    <div
      id="mobile-overlay"
      class="fixed inset-0 z-[60] hidden bg-black/70 backdrop-blur-sm transition-opacity duration-300 md:hidden"
    >
    </div>

    <!-- Mobile Bottom Drawer -->
    <div
      id="mobile-menu"
      class="fixed right-0 bottom-0 left-0 z-[70] flex translate-y-full flex-col gap-6 rounded-t-[2.5rem] border-t border-gruv-border/40 p-8 pb-10 pt-6 shadow-2xl transition-transform duration-300 ease-out md:hidden"
      style="background: linear-gradient(180deg, #282828 0%, #1d2021 100%);"
    >
      <!-- Drawer Handle -->
      <div class="bg-gruv-border/60 mx-auto h-1.5 w-12 rounded-full"></div>

      <!-- Brand -->
      <div class="flex items-center gap-3">
        <div class="pixel-pet scale-50 origin-left"></div>
        <div class="flex flex-col">
          <span class="text-gruv-text text-lg font-bold tracking-tight">abx <span class="text-gruv-muted font-normal">//</span> dev</span>
          <span class="text-gruv-muted text-[10px] font-bold tracking-widest uppercase">Software Engineer</span>
        </div>
      </div>

      <div class="bg-gruv-border/20 h-px w-full"></div>

      <!-- Current section indicator -->
      <div class="flex items-center gap-2 px-5">
        <span class="text-gruv-muted/50 text-[10px] font-bold tracking-[0.2em] uppercase">Viewing</span>
        <span id="current-section" class="text-gruv-orange text-[10px] font-bold tracking-[0.2em] uppercase">Work</span>
        <div class="bg-gruv-border/20 ml-auto h-1 flex-1 rounded-full overflow-hidden">
          <div id="section-progress" class="bg-gruv-orange h-full w-0 rounded-full transition-all duration-500 ease-out"></div>
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <a
          href="#experience"
          class="mobile-link group relative flex items-center gap-4 rounded-2xl border border-transparent px-5 py-4 text-xl font-bold tracking-tight transition-all hover:border-gruv-border/40 hover:bg-gruv-bg/40 hover:pl-7"
          data-section="Work"
        >
          <span class="absolute left-0 top-1/2 h-6 w-1 -translate-y-1/2 rounded-r-full bg-gruv-orange opacity-0 transition-all duration-300 group-[.active]:opacity-100"></span>
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gruv-bg/60 text-gruv-orange transition-all duration-300 group-[.active]:bg-gruv-orange group-[.active]:text-gruv-bg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
          </span>
          <span>Work</span>
          <svg class="ml-auto text-gruv-muted opacity-0 transition-all group-hover:opacity-100 group-hover:translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a
          href="#projects"
          class="mobile-link group relative flex items-center gap-4 rounded-2xl border border-transparent px-5 py-4 text-xl font-bold tracking-tight transition-all hover:border-gruv-border/40 hover:bg-gruv-bg/40 hover:pl-7"
          data-section="Projects"
        >
          <span class="absolute left-0 top-1/2 h-6 w-1 -translate-y-1/2 rounded-r-full bg-gruv-blue opacity-0 transition-all duration-300 group-[.active]:opacity-100"></span>
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gruv-bg/60 text-gruv-blue transition-all duration-300 group-[.active]:bg-gruv-blue group-[.active]:text-gruv-bg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
          </span>
          <span>Projects</span>
          <svg class="ml-auto text-gruv-muted opacity-0 transition-all group-hover:opacity-100 group-hover:translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a
          href="#education"
          class="mobile-link group relative flex items-center gap-4 rounded-2xl border border-transparent px-5 py-4 text-xl font-bold tracking-tight transition-all hover:border-gruv-border/40 hover:bg-gruv-bg/40 hover:pl-7"
          data-section="Education"
        >
          <span class="absolute left-0 top-1/2 h-6 w-1 -translate-y-1/2 rounded-r-full bg-gruv-purple opacity-0 transition-all duration-300 group-[.active]:opacity-100"></span>
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gruv-bg/60 text-gruv-purple transition-all duration-300 group-[.active]:bg-gruv-purple group-[.active]:text-gruv-bg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
          </span>
          <span>Education</span>
          <svg class="ml-auto text-gruv-muted opacity-0 transition-all group-hover:opacity-100 group-hover:translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a
          href="#opensource"
          class="mobile-link group relative flex items-center gap-4 rounded-2xl border border-transparent px-5 py-4 text-xl font-bold tracking-tight transition-all hover:border-gruv-border/40 hover:bg-gruv-bg/40 hover:pl-7"
          data-section="Open Source"
        >
          <span class="absolute left-0 top-1/2 h-6 w-1 -translate-y-1/2 rounded-r-full bg-gruv-green opacity-0 transition-all duration-300 group-[.active]:opacity-100"></span>
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gruv-bg/60 text-gruv-green transition-all duration-300 group-[.active]:bg-gruv-green group-[.active]:text-gruv-bg">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          </span>
          <span>Activity</span>
          <svg class="ml-auto text-gruv-muted opacity-0 transition-all group-hover:opacity-100 group-hover:translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

      <a
        href="mailto:abinash@theabx.in"
        class="magnetic bg-gruv-orange text-gruv-bg shadow-premium hover:shadow-[0_0_30px_rgba(254,128,25,0.3)] flex items-center justify-center gap-3 rounded-full px-5 py-4 text-center text-base font-bold transition-all hover:scale-[1.02]"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polyline points="22 2 15 22 11 13 2 9 22 2"></polyline></svg>
        Get in touch
      </a>
    </div>

    <slot />

    <footer class="border-gruv-border/20 mt-20 border-t px-6 py-24">
      <div class="mx-auto flex max-w-6xl flex-col">
        <div class="flex flex-col items-center justify-between gap-12 md:flex-row">
          <div class="flex flex-col gap-4 text-center md:text-left">
            <div>
              <div class="text-2xl font-bold tracking-tighter">
                Let's work together
              </div>
              <p class="text-gruv-muted text-sm">
                Java · Go · Payments · Platform
              </p>
            </div>
          </div>
          <div class="flex flex-col items-center gap-4 sm:flex-row">
            <div class="flex items-center gap-3">
              <a
                href="https://github.com/AbiXnash"
                target="_blank"
                class="text-gruv-muted hover:text-gruv-text hover:bg-gruv-surface/50 flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold tracking-widest uppercase transition-all"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                GitHub
              </a>
              <a
                href="https://instagram.com/abx.engg"
                target="_blank"
                class="text-gruv-muted hover:text-gruv-text hover:bg-gruv-surface/50 flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-bold tracking-widest uppercase transition-all"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                Instagram
              </a>
            </div>
            <a
              href="mailto:abinash@theabx.in"
              class="magnetic bg-gruv-orange text-gruv-bg hover:shadow-[0_0_30px_rgba(254,128,25,0.3)] rounded-full px-6 py-3 text-sm font-bold transition-all hover:scale-105"
            >
              Email me
            </a>
          </div>
        </div>
        <div class="bg-gruv-border/10 mx-auto mt-16 h-px w-full max-w-md"></div>
        <div class="text-gruv-muted mx-auto mt-8 flex items-center gap-4 text-[11px] tracking-widest uppercase">
          <span>© {new Date().getFullYear()} Abinash Selvarasu</span>
          <span class="text-gruv-border">·</span>
          <span class="tracking-normal text-gruv-muted/60 font-mono text-[10px]">crafted with gruvbox</span>
        </div>
      </div>
    </footer>

    <script>
      function setup() {
        const toggle = document.getElementById("menu-toggle");
        const menu = document.getElementById("mobile-menu");
        const overlay = document.getElementById("mobile-overlay");
        const links = document.querySelectorAll(".mobile-link");

        function toggleMenu() {
          const isOpen = menu?.classList.contains("translate-y-0");

          if (isOpen) {
            menu?.classList.remove("translate-y-0");
            menu?.classList.add("translate-y-full");
            overlay?.classList.add("hidden");
            document.body.style.overflow = "";
          } else {
            menu?.classList.remove("translate-y-full");
            menu?.classList.add("translate-y-0");
            overlay?.classList.remove("hidden");
            document.body.style.overflow = "hidden";
            history.pushState({ menu: true }, "");
          }
        }

        toggle?.addEventListener("click", toggleMenu);
        overlay?.addEventListener("click", toggleMenu);

        links.forEach((l) => l.addEventListener("click", toggleMenu));

        // Scroll Reveal Observer
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("active");
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
        );

        document
          .querySelectorAll(".reveal")
          .forEach((el) => revealObserver.observe(el));

        // Scroll bar and glass nav
        const scrollBar = document.getElementById("scroll-bar");
        const navbar = document.getElementById("navbar");

        function onScroll() {
          const docEl = document.documentElement;
          const scrollTop = docEl.scrollTop || document.body.scrollTop;
          const scrollHeight = docEl.scrollHeight - docEl.clientHeight;

          // Scroll progress bar
          if (scrollBar && scrollHeight > 0) {
            scrollBar.style.width = `${(scrollTop / scrollHeight) * 100}%`;
          }

          // Glass nav effect
          if (navbar) {
            const hero = document.querySelector("section");
            const heroBottom = hero?.getBoundingClientRect().bottom ?? 200;
            if (scrollTop > 60) {
              navbar.classList.add("bg-gruv-bg/80", "backdrop-blur-xl", "border-gruv-border/50");
              navbar.classList.remove("bg-gruv-bg", "border-gruv-border/30");
            } else {
              navbar.classList.remove("bg-gruv-bg/80", "backdrop-blur-xl", "border-gruv-border/50");
              navbar.classList.add("bg-gruv-bg", "border-gruv-border/30");
            }
          }
        }

        // Section tracking
        const sections = [
          { id: "experience", name: "Work" },
          { id: "projects", name: "Projects" },
          { id: "education", name: "Education" },
          { id: "opensource", name: "Open Source" },
        ];
        const sectionElements = sections
          .map((s) => document.getElementById(s.id))
          .filter(Boolean);
        const currentSectionEl = document.getElementById("current-section");
        const drawerProgressEl = document.getElementById("section-progress");
        const mobileLinks = document.querySelectorAll<HTMLElement>(".mobile-link");
        const navLinks = document.querySelectorAll<HTMLElement>(".nav-link");

        const sectionObserver = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible.length > 0) {
              const id = visible[0].target.id;
              const match = sections.find((s) => s.id === id);
              const name = match?.name ?? "";
              if (currentSectionEl) currentSectionEl.textContent = name;
              mobileLinks.forEach((link) => {
                link.classList.toggle(
                  "active",
                  link.getAttribute("data-section") === name,
                );
              });
              navLinks.forEach((link) => {
                link.classList.toggle(
                  "text-gruv-text",
                  link.getAttribute("data-section") === name,
                );
                link.classList.toggle(
                  "text-gruv-muted",
                  link.getAttribute("data-section") !== name,
                );
              });
            }
            onScroll();
          },
          { threshold: 0.2, rootMargin: "0px 0px -30% 0px" },
        );

        sectionElements.forEach((el) => sectionObserver.observe(el));
        document.addEventListener("scroll", onScroll);
        onScroll();

        // 3D Tilt Cards with Glare
        document.addEventListener("mousemove", (e) => {
          const card = e.target.closest(".tilt-card") as HTMLElement;
          if (!card) return;
          
          let glare = card.querySelector('.glare') as HTMLElement;
          if (!glare) {
            glare = document.createElement('div');
            glare.className = 'glare';
            glare.style.position = 'absolute';
            glare.style.inset = '0';
            glare.style.pointerEvents = 'none';
            glare.style.opacity = '0';
            glare.style.transition = 'opacity 0.5s ease';
            card.appendChild(glare);
          }

          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          const rotateX = ((y - centerY) / centerY) * -4;
          const rotateY = ((x - centerX) / centerX) * 4;
          
          glare.style.opacity = '1';
          glare.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.06) 0%, transparent 60%)`;

          card.style.transition = "transform 0.05s linear, box-shadow 0.5s, background-color 0.5s, border-color 0.5s, color 0.5s";
          card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
          card.style.zIndex = "10";
        });

        document.addEventListener("mouseout", (e) => {
          const card = e.target.closest(".tilt-card") as HTMLElement;
          if (!card) return;
          if (!card.contains(e.relatedTarget as Node)) {
            const glare = card.querySelector('.glare') as HTMLElement;
            if (glare) glare.style.opacity = '0';

            card.style.transition = "transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.5s, background-color 0.5s, border-color 0.5s, color 0.5s";
            card.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)";
            card.style.zIndex = "1";
            setTimeout(() => {
              card.style.transition = "";
            }, 500);
          }
        });
        // Magnetic Buttons
        const magneticElements = document.querySelectorAll<HTMLElement>(".magnetic");
        magneticElements.forEach((btn) => {
          btn.addEventListener("mousemove", (e) => {
            const rect = btn.getBoundingClientRect();
            const h = rect.width / 2;
            const v = rect.height / 2;
            const x = e.clientX - rect.left - h;
            const y = e.clientY - rect.top - v;
            
            btn.style.transition = "none";
            btn.style.transform = `translate(${x * 0.3}px, ${y * 0.3}px)`;
          });

          btn.addEventListener("mouseleave", () => {
            btn.style.transition = "transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)";
            btn.style.transform = `translate(0px, 0px)`;
            setTimeout(() => {
              btn.style.transition = "";
            }, 500);
          });
        });

        // Interactive Ghost Eyes
        const ghostPets = document.querySelectorAll<HTMLElement>(".pixel-pet");
        document.addEventListener("mousemove", (e) => {
          ghostPets.forEach((ghost) => {
            const rect = ghost.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            const dx = e.clientX - centerX;
            const dy = e.clientY - centerY;
            const angle = Math.atan2(dy, dx);
            const distance = Math.min(4, Math.hypot(dx, dy) / 20);
            
            const eyeX = Math.cos(angle) * distance;
            const eyeY = Math.sin(angle) * distance;
            
            ghost.style.setProperty('--eye-x', `${eyeX}px`);
            ghost.style.setProperty('--eye-y', `${eyeY}px`);
          });
        });

        // Hacker Text Scramble Effect
        const chars = '!<>-_\\\\/[]{}—=+*^?#________';
        const scrambleElements = document.querySelectorAll<HTMLElement>(".scramble-text");
        
        const scrambleObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const element = entry.target as HTMLElement;
              observer.unobserve(element); // Stop it from playing again and again
              
              const original = element.dataset.original || element.textContent || "";
              if (!element.dataset.original) element.dataset.original = original;
              
              element.dataset.scrambling = "true";
              let iteration = 0;
              
              const interval = setInterval(() => {
                element.textContent = original.split("").map((letter, index) => {
                  if (index < iteration || letter === " ") return original[index];
                  return chars[Math.floor(Math.random() * chars.length)];
                }).join("");
                
                if (iteration >= original.length) {
                  clearInterval(interval);
                  element.dataset.scrambling = "false";
                }
                iteration += 1 / 3;
              }, 30);
            }
          });
        }, { threshold: 0.5 });
        
        scrambleElements.forEach(el => scrambleObserver.observe(el));
      }

      // Close menu on back gesture/button (registered once, outside setup)
      let menu: HTMLElement | null;
      window.addEventListener("popstate", () => {
        menu = document.getElementById("mobile-menu");
        if (menu?.classList.contains("translate-y-0")) {
          const overlay = document.getElementById("mobile-overlay");
          menu.classList.remove("translate-y-0");
          menu.classList.add("translate-y-full");
          overlay?.classList.add("hidden");
          document.body.style.overflow = "";
        }
      });

      // Initial setup
      setup();

      // Re-setup after client-side navigation and remove any swapped-in loader.
      document.addEventListener("astro:after-swap", () => {
        dismissLoader(true);
        setup();
      });
    </script>
  </body>
</html>
